// circlelib DSL grammar.
//
// A program is a sequence of top-level items: imports, top-level
// bindings, component definitions, and at most one scene block.
// Component bodies and scene blocks contain statements that are either
// named assignments or bare calls. Group blocks nest the same kind of
// statements.

start: top_item*

top_item: import_stmt
        | component_def
        | scene_def
        | top_binding
        | animate_def

import_stmt: "import" STRING "as" NAME

top_binding: NAME "=" expr

component_def: "component" NAME "{" stmt* "}"

scene_def: "scene" "{" stmt* "}"

animate_def: "animate" "{" anim_stmt* "}"

anim_stmt: anim_binding
         | anim_rule

anim_binding: NAME "=" expr
anim_rule: NAME "." NAME "=" expr

stmt: assignment
    | call_stmt
    | group_stmt

assignment: NAME "=" expr
call_stmt: call
group_stmt: "Group" group_args? "{" stmt* "}"

group_args: "(" [arg_list] ")"

call: qualified_name "(" [arg_list] ")"

qualified_name: NAME ("." NAME)*

arg_list: arg ("," arg)* ","?
arg: NAME "=" expr

?expr: add_expr

?add_expr: mul_expr
         | add_expr "+" mul_expr   -> add
         | add_expr "-" mul_expr   -> sub

?mul_expr: unary_expr
         | mul_expr "*" unary_expr -> mul
         | mul_expr "/" unary_expr -> div
         | mul_expr "%" unary_expr -> mod

?unary_expr: atom
           | "-" unary_expr        -> neg

?atom: tuple_lit
     | rgb_call
     | anim_call
     | NUMBER          -> number_lit
     | STRING          -> string_lit
     | HEXCOLOR        -> color_lit
     | qualified_name  -> ident_expr
     | call            -> call_expr
     | "(" expr ")"

rgb_call: "rgb"  "(" expr "," expr "," expr ")"           -> rgb3
        | "rgba" "(" expr "," expr "," expr "," expr ")"  -> rgb4

anim_call: "anim" "(" expr "," expr "," expr "," expr ")"                          -> anim4
         | "anim" "(" expr "," expr "," expr "," expr "," "easing" "=" NAME ")"    -> anim5

tuple_lit: "(" expr ("," expr)+ ","? ")"

NAME: /[A-Za-z_][A-Za-z0-9_]*/
HEXCOLOR: /#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})/

%import common.SIGNED_NUMBER -> NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.WS
%import common.CPP_COMMENT
%import common.C_COMMENT

%ignore WS
%ignore CPP_COMMENT
%ignore C_COMMENT
