// circlelib stdlib — vehicles/wheels
//
// Reusable wheel sets. `Pair` is two wheels on the X axis (centered on
// the call's origin). `Quad` is the four corners of a small car-sized
// rectangle.

component Pair {
    Cylinder(radius=0.45, height=0.3, position=( 1.4, 0.45, 0), rotation=(0, 0, 90), color=#1a1a1a)
    Cylinder(radius=0.45, height=0.3, position=(-1.4, 0.45, 0), rotation=(0, 0, 90), color=#1a1a1a)
}

component Quad {
    Cylinder(radius=0.45, height=0.3, position=( 1.6, 0.45,  1.1), rotation=(0, 0, 90), color=#1a1a1a)
    Cylinder(radius=0.45, height=0.3, position=(-1.6, 0.45,  1.1), rotation=(0, 0, 90), color=#1a1a1a)
    Cylinder(radius=0.45, height=0.3, position=( 1.6, 0.45, -1.1), rotation=(0, 0, 90), color=#1a1a1a)
    Cylinder(radius=0.45, height=0.3, position=(-1.6, 0.45, -1.1), rotation=(0, 0, 90), color=#1a1a1a)
}
