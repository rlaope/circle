// circlelib stdlib — furniture/chair
//
// Fixed-shape Chair and Stool. The caller positions the whole piece
// via the standard `position` / `rotation` arguments on the call.

component Chair {
    // Four legs.
    Group(position=( 0.7, 0.5,  0.7)) { Cube(width=0.15, height=1.0, depth=0.15, color=#7a4a22) }
    Group(position=(-0.7, 0.5,  0.7)) { Cube(width=0.15, height=1.0, depth=0.15, color=#7a4a22) }
    Group(position=( 0.7, 0.5, -0.7)) { Cube(width=0.15, height=1.0, depth=0.15, color=#7a4a22) }
    Group(position=(-0.7, 0.5, -0.7)) { Cube(width=0.15, height=1.0, depth=0.15, color=#7a4a22) }

    // Seat.
    Cube(width=1.6, height=0.15, depth=1.6, position=(0, 1.05, 0), color=#a86a3a)

    // Backrest.
    Cube(width=1.6, height=1.4, depth=0.15, position=(0, 1.85, -0.7), color=#a86a3a)
}

component Stool {
    Group(position=( 0.55, 0.4,  0.55)) { Cube(width=0.12, height=0.8, depth=0.12, color=#5a3a1c) }
    Group(position=(-0.55, 0.4,  0.55)) { Cube(width=0.12, height=0.8, depth=0.12, color=#5a3a1c) }
    Group(position=( 0.55, 0.4, -0.55)) { Cube(width=0.12, height=0.8, depth=0.12, color=#5a3a1c) }
    Group(position=(-0.55, 0.4, -0.55)) { Cube(width=0.12, height=0.8, depth=0.12, color=#5a3a1c) }

    Cube(width=1.3, height=0.12, depth=1.3, position=(0, 0.85, 0), color=#7a4a22)
}
