// A row of Cones on top of a Plane — apex at (0, height, 0).

scene {
    Plane(width=20, depth=10, position=(0, 0, 0), color=#1a1a1a)
    Cone(radius=1.0, height=2.0, position=(-6, 0, 0), color=#ff5577)
    Cone(radius=1.5, height=3.0, position=(-2, 0, 0), color=#3aa0ff)
    Cone(radius=2.0, height=4.0, position=( 3, 0, 0), color=#ffd966)
    Cone(radius=0.6, height=5.0, position=( 7, 0, 0), color=#7ae0ff)
}
